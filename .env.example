# Copy this file to .env.local (or set the variables in the Vercel dashboard).
# .env / .env.local are ignored by git - never commit real secrets.

# Signs the session cookie that carries cart / mode / stock between requests.
# Any long random string works. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Local development only. Vercel sets the port itself.
PORT=4000